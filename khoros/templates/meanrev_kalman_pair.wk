# Khoros Visual Programming Workspace
# generated by khoros_cantata.authoring from spec 'meanrev_kalman_pair'
# mode: stream
# Pairs mean reversion: a Kalman filter tracks the hedge ratio y = alpha + beta*x; the
# one-step prior spread is z-scored over a trailing window; enter short the spread above +2,
# long below -2; the position is held until the opposite signal.
VariablesBegin:
VariablesEnd:

#GlyphBegin
# Glyph 'x': stream input
Glyph:STREAM:kinput::1:20:40:: -name 'x'
# Glyph 'y': stream input
Glyph:STREAM:kinput::2:20:80:: -name 'y'
# Glyph 'hedge' (FINANCE:kkalmanpair): Kalman dynamic hedge ratio (prior spread o, beta o2, alpha o3).
#   why: dynamic hedge ratio; spread uses the prior estimate (no look-ahead)
#   cumulative lag: 0.00 samples
Glyph:FINANCE:kkalmanpair::3:120:120:: -delta 0.0001 -r 0.1
# Glyph 'z' (FINANCE:kzscore): Trailing-window z-score.
#   why: normalise the spread over the last 60 bars
#   cumulative lag: 29.50 samples
Glyph:FINANCE:kzscore::4:220:160:: -window 60
# Glyph 'short' (DATAMANIP:kcompare): Comparison (eq, ne, lt, le, gt, ge) -> -true/-false values.
#   why: spread rich -> short the spread
#   cumulative lag: 29.50 samples
Glyph:DATAMANIP:kcompare::5:320:200:: -op 'gt' -real 2.0 -true -1 -false 0
# Glyph 'long' (DATAMANIP:kcompare): Comparison (eq, ne, lt, le, gt, ge) -> -true/-false values.
#   why: spread cheap -> long the spread
#   cumulative lag: 29.50 samples
Glyph:DATAMANIP:kcompare::6:420:240:: -op 'lt' -real -2.0 -true 1 -false 0
# Glyph 'entry' (DATAMANIP:kadd): i1 + i2 (or + -real constant).
#   why: combine entry events (+1 / -1 / 0)
#   cumulative lag: 29.50 samples
Glyph:DATAMANIP:kadd::7:520:280::
# Glyph 'pos' (FINANCE:khold): Hold last non-zero event (events -> position).
#   why: hold the last entry until the opposite one
#   cumulative lag: 29.50 samples
Glyph:FINANCE:khold::8:620:320::
# Glyph 'position': stream output
Glyph:STREAM:koutput::9:800:360:: -name 'position'
# Glyph 'zscore': stream output
Glyph:STREAM:koutput::10:800:400:: -name 'zscore'
# Glyph 'spread': stream output
Glyph:STREAM:koutput::11:800:440:: -name 'spread'
# Glyph 'beta': stream output
Glyph:STREAM:koutput::12:800:480:: -name 'beta'
#GlyphEnd
#ConnectionBegin
NodeConnection:1:o:3:i1:
NodeConnection:2:o:3:i2:
NodeConnection:3:o:4:i:
NodeConnection:4:o:5:i1:
NodeConnection:4:o:6:i1:
NodeConnection:6:o:7:i1:
NodeConnection:5:o:7:i2:
NodeConnection:7:o:8:i:
NodeConnection:8:o:9:i:
NodeConnection:4:o:10:i:
NodeConnection:3:o:11:i:
NodeConnection:3:o2:12:i:
#ConnectionEnd
