# Khoros Visual Programming Workspace
# generated by khoros_cantata.authoring from spec 'trend_ema_vol'
# mode: stream
# Trend following: long when the fast EMA is above the slow EMA, short when below
# (position held between crossings), and flat whenever short-term volatility is high.
VariablesBegin:
VariablesEnd:

#GlyphBegin
# Glyph 'price': stream input
Glyph:STREAM:kinput::1:20:40:: -name 'price'
# Glyph 'fast' (SIGNAL:kema): Exponential moving average.
#   why: fast trend estimate; ~4.5-bar lag
#   cumulative lag: 4.50 samples
Glyph:SIGNAL:kema::2:120:80:: -span 10
# Glyph 'slow' (SIGNAL:kema): Exponential moving average.
#   why: slow trend estimate; ~19.5-bar lag sets the template's latency
#   cumulative lag: 19.50 samples
Glyph:SIGNAL:kema::3:220:120:: -span 40
# Glyph 'ret' (FINANCE:klogret): Log return ln(x_t/x_{t-1}).
#   why: log returns for volatility
#   cumulative lag: 0.50 samples
Glyph:FINANCE:klogret::4:320:160::
# Glyph 'cross' (SIGNAL:kcross): Crossover events: +1 when i1 crosses above i2, -1 below.
#   why: +1 / -1 events when fast crosses slow
#   cumulative lag: 19.50 samples
Glyph:SIGNAL:kcross::5:420:200::
# Glyph 'vol' (SIGNAL:krunstats): Running statistic (cumulative or trailing window).
#   why: 20-bar realised volatility of returns
#   cumulative lag: 10.00 samples
Glyph:SIGNAL:krunstats::6:520:240:: -stat 'std' -window 20
# Glyph 'pos' (FINANCE:khold): Hold last non-zero event (events -> position).
#   why: turn crossing events into a held +1 / -1 position
#   cumulative lag: 19.50 samples
Glyph:FINANCE:khold::7:620:280::
# Glyph 'calm' (DATAMANIP:kcompare): Comparison (eq, ne, lt, le, gt, ge) -> -true/-false values.
#   why: 1 when volatility is below 1.5% per bar, else 0
#   cumulative lag: 10.00 samples
Glyph:DATAMANIP:kcompare::8:120:320:: -op 'lt' -real 0.015
# Glyph 'gated' (DATAMANIP:kmul): i1 * i2 (or * -real).
#   why: position times calm-market filter
#   cumulative lag: 19.50 samples
Glyph:DATAMANIP:kmul::9:220:360::
# Glyph 'position': stream output
Glyph:STREAM:koutput::10:800:400:: -name 'position'
# Glyph 'fast_ema': stream output
Glyph:STREAM:koutput::11:800:440:: -name 'fast_ema'
# Glyph 'slow_ema': stream output
Glyph:STREAM:koutput::12:800:480:: -name 'slow_ema'
# Glyph 'volatility': stream output
Glyph:STREAM:koutput::13:800:520:: -name 'volatility'
#GlyphEnd
#ConnectionBegin
NodeConnection:1:o:2:i:
NodeConnection:1:o:3:i:
NodeConnection:2:o:5:i1:
NodeConnection:3:o:5:i2:
NodeConnection:5:o:7:i:
NodeConnection:1:o:4:i:
NodeConnection:4:o:6:i:
NodeConnection:6:o:8:i1:
NodeConnection:7:o:9:i1:
NodeConnection:8:o:9:i2:
NodeConnection:9:o:10:i:
NodeConnection:2:o:11:i:
NodeConnection:3:o:12:i:
NodeConnection:6:o:13:i:
#ConnectionEnd
