# Khoros Visual Programming Workspace
# generated by khoros_cantata.authoring from spec 'vol_regime'
# mode: stream
# Volatility regime labelling: 0 = calm, 1 = normal, 2 = stressed, from smoothed
# 20-bar realised volatility of log returns.
VariablesBegin:
VariablesEnd:

#GlyphBegin
# Glyph 'price': stream input
Glyph:STREAM:kinput::1:20:40:: -name 'price'
# Glyph 'ret' (FINANCE:klogret): Log return ln(x_t/x_{t-1}).
#   why: log returns
#   cumulative lag: 0.50 samples
Glyph:FINANCE:klogret::2:120:80::
# Glyph 'vol' (SIGNAL:krunstats): Running statistic (cumulative or trailing window).
#   why: 20-bar realised volatility
#   cumulative lag: 10.00 samples
Glyph:SIGNAL:krunstats::3:220:120:: -stat 'std' -window 20
# Glyph 'smooth' (SIGNAL:kema): Exponential moving average.
#   why: smooth volatility to reduce regime flicker
#   cumulative lag: 14.50 samples
Glyph:SIGNAL:kema::4:320:160:: -span 10
# Glyph 'regime' (FINANCE:kthreshold3): Three-level regime 0/1/2 by -lo/-hi.
#   why: thresholds in return units per bar
#   cumulative lag: 14.50 samples
Glyph:FINANCE:kthreshold3::5:420:200:: -lo 0.01 -hi 0.02
# Glyph 'regime': stream output
Glyph:STREAM:koutput::6:800:240:: -name 'regime'
# Glyph 'volatility': stream output
Glyph:STREAM:koutput::7:800:280:: -name 'volatility'
#GlyphEnd
#ConnectionBegin
NodeConnection:1:o:2:i:
NodeConnection:2:o:3:i:
NodeConnection:3:o:4:i:
NodeConnection:4:o:5:i:
NodeConnection:5:o:6:i:
NodeConnection:4:o:7:i:
#ConnectionEnd
